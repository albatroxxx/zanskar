# Copy to deploy/.env and fill in. `docker compose -f deploy/docker-compose.yml`
# reads deploy/.env automatically. Keep this file OUT of version control.

# REQUIRED. The master key seals every stored credential and secret; losing it
# makes them unrecoverable, so generate it once and back it up somewhere the
# database backup cannot reach. Generate a value:
#   openssl rand -base64 32
ZANSKAR_MASTER_KEY=

# OPTIONAL. Release to run, as published on ghcr.io/albatroxxx/zanskar (the tag
# without the leading v, e.g. 1.0.0 or 1.0.0-rc.1). Defaults to `latest`, which
# only ever points at a stable release — set this explicitly to try a release
# candidate.
#ZANSKAR_VERSION=1.0.0

# OPTIONAL. Public hostname for automatic HTTPS via Let's Encrypt. Requires
# ports 80 and 443 reachable from the internet and DNS pointing at this host.
# Leave unset to serve https://localhost/ with a self-signed certificate
# (browser warning) for a local trial.
#ZANSKAR_SITE_ADDRESS=vpn.example.com
