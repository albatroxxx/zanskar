# Zanskar configuration for the single-instance systemd service. The unit reads
# this file as its EnvironmentFile. `zanskar init` generates it for you; this
# example is for editing by hand. Restart after changes:
#   sudo systemctl restart zanskar
#
# Full reference: docs/deploy.md and `zanskar init --help`.

# REQUIRED. 32-byte base64 master key; it seals every stored credential and
# secret, so back it up somewhere the database backup cannot reach — losing it
# makes them unrecoverable. Generate one with:
#   openssl rand -base64 32
ZANSKAR_MASTER_KEY=

# Bind to loopback and terminate TLS in a reverse proxy (Caddy/nginx) in front;
# the gateway refuses plain HTTP on a non-loopback address. Set
# ZANSKAR_TRUST_PROXY_TLS=true so it honours the proxy's X-Forwarded-* headers
# (and records real client IPs in the audit log).
# How the listener is protected: managed (Zanskar serves TLS with a certificate it
# manages: self-signed at first start, replaced from the console), file (the
# certificate below), or proxy (plain HTTP on loopback behind a TLS proxy). Unset
# means file when ZANSKAR_TLS_CERT is set, otherwise proxy.
#ZANSKAR_TLS_MODE=managed

# Plain-HTTP listener that redirects to the HTTPS listener; only with a TLS mode.
# The default install sets :80 alongside a 443 listener.
#ZANSKAR_HTTP_REDIRECT_ADDR=:80

ZANSKAR_LISTEN_ADDR=127.0.0.1:8443
ZANSKAR_TRUST_PROXY_TLS=true
# Comma-separated CIDRs whose X-Forwarded-* headers are trusted (the proxy).
#ZANSKAR_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# SQLite database and local recordings under the service state directory.
ZANSKAR_DB_DRIVER=sqlite
ZANSKAR_DB_DSN=file:/var/lib/zanskar/zanskar.db?_pragma=journal_mode(WAL)&_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)
ZANSKAR_RECORDINGS_DIR=/var/lib/zanskar/recordings

# guacd address for RDP/VNC desktop sessions. Empty (unset) disables desktops.
# Install-time default: the admin console's Settings page can override it live.
#ZANSKAR_GUACD_ADDR=127.0.0.1:4822

# Container CLI used to spawn ephemeral database session containers (ADR 0017).
# Empty (unset) defaults to "docker" on PATH; set an absolute path or "podman".
#ZANSKAR_DOCKER_PATH=/usr/bin/docker

# Recordings in an S3-compatible bucket: install-time default; the console's
# Settings page can override it (with a sealed access key) and move local
# recordings into the bucket. See docs/deploy.md.
#ZANSKAR_RECORDINGS_S3_BUCKET=
#ZANSKAR_RECORDINGS_S3_PREFIX=recordings/
#ZANSKAR_RECORDINGS_S3_REGION=
#ZANSKAR_RECORDINGS_S3_ENDPOINT=
#ZANSKAR_RECORDINGS_S3_KMS_KEY=

# The AWS principal this gateway presents, for autoscaling trust policies (ADR
# 0023). Normally detected from the instance profile or IRSA and left unset;
# set it for a gateway outside AWS or to present a different role.
#ZANSKAR_AWS_GATEWAY_PRINCIPAL=arn:aws:iam::123456789012:role/zanskar-gateway

# Image started beside each MySQL/MariaDB session as the credential-holding relay:
# the gateway's own image at its own version. Install-time default; the console's
# Settings page can override it (a mirror, or a local build for development).
#ZANSKAR_DBPROXY_IMAGE=ghcr.io/albatroxxx/zanskar:1.1.0

ZANSKAR_LOG_FORMAT=json
# Install-time default; the console's Settings page can raise it live and reset it.
ZANSKAR_LOG_LEVEL=info

# Only when this file is not at /etc/zanskar/env: its path, so the running gateway
# can tell the console when it changed and a restart is due.
#ZANSKAR_ENV_FILE=/etc/zanskar/env
