# Copy to .env for local development. Never commit .env.
ZANSKAR_LISTEN_ADDR=127.0.0.1:8443
ZANSKAR_ADMIN_LISTEN_ADDR=            # optional separate listener for the admin UI/API
ZANSKAR_DB_DRIVER=sqlite              # sqlite | postgres
ZANSKAR_DB_DSN=file:zanskar.db?_pragma=journal_mode(WAL)&_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)
# ZANSKAR_DB_DSN=postgres://zanskar:zanskar@localhost:5432/zanskar?sslmode=disable
ZANSKAR_MASTER_KEY=                   # base64, 32 bytes; generate with: zanskar keygen
ZANSKAR_TLS_CERT=                     # empty = plain HTTP (dev only, bind to loopback)
ZANSKAR_TLS_KEY=
ZANSKAR_GUACD_ADDR=127.0.0.1:4822
ZANSKAR_TRUST_PROXY_TLS=false         # true only when a TLS proxy fronts a loopback-bound Zanskar
ZANSKAR_ISSUER=Zanskar                # name shown in authenticator apps
ZANSKAR_REQUIRE_MFA=true              # false only for throwaway dev databases
ZANSKAR_ADMIN_PASSWORD=               # optional: used by `zanskar admin create` instead of prompting
ZANSKAR_LOG_LEVEL=info
ZANSKAR_LOG_FORMAT=json
