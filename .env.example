# Copy to .env for local development. Never commit .env.
ZANSKAR_LISTEN_ADDR=127.0.0.1:8443
ZANSKAR_ADMIN_LISTEN_ADDR=            # optional separate listener for the admin UI/API
ZANSKAR_DB_DRIVER=sqlite              # sqlite | postgres
ZANSKAR_DB_DSN=file:zanskar.db?_pragma=journal_mode(WAL)&_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)
# ZANSKAR_DB_DSN=postgres://zanskar:zanskar@localhost:5432/zanskar?sslmode=disable
ZANSKAR_MASTER_KEY=                   # base64, 32 bytes; generate with: zanskar keygen
ZANSKAR_TLS_CERT=                     # empty = plain HTTP (dev only, bind to loopback)
ZANSKAR_TLS_KEY=
ZANSKAR_GUACD_ADDR=                   # host:port of guacd; empty disables RDP and VNC
ZANSKAR_DOCKER_PATH=                  # container CLI for database sessions; empty = "docker" on PATH
ZANSKAR_TRUST_PROXY_TLS=false         # true only when a TLS proxy fronts a loopback-bound Zanskar
ZANSKAR_ISSUER=Zanskar                # name shown in authenticator apps
ZANSKAR_REQUIRE_MFA=true              # false only for throwaway dev databases
ZANSKAR_RECORDINGS_DIR=data/recordings # session recordings (0700 directory, 0600 files)
# ZANSKAR_RECORDINGS_S3_BUCKET=          # set to store recordings in S3 instead of the directory
# ZANSKAR_RECORDINGS_S3_PREFIX=recordings/
# ZANSKAR_RECORDINGS_S3_REGION=          # empty: normal AWS region resolution
# ZANSKAR_RECORDINGS_S3_ENDPOINT=        # https://minio.example:9000 for S3-compatible stores
# ZANSKAR_RECORDINGS_S3_KMS_KEY=         # KMS key id/arn; empty uses SSE-S3 (AES256)
# ZANSKAR_RECORDINGS_SPOOL_DIR=          # local spool for in-progress recordings (default $TMPDIR/zanskar-spool)
ZANSKAR_AWS_GATEWAY_PRINCIPAL=        # ARN the gateway runs as, shown in ASG trust policies (autoscaling)
ZANSKAR_ADMIN_PASSWORD=               # optional: used by `zanskar admin create` instead of prompting
ZANSKAR_LOG_LEVEL=info
ZANSKAR_LOG_FORMAT=json

# SIEM export of the audit log (at-least-once; receivers dedupe by event id/hash)
ZANSKAR_SIEM_SYSLOG_ADDR=             # tcp://collector:514 or tls://collector:6514; CEF over RFC 5424 with octet counting
ZANSKAR_SIEM_SYSLOG_FORMAT=cef        # cef | json
ZANSKAR_SIEM_SYSLOG_CA=               # PEM file pinning the collector's CA for tls://
ZANSKAR_SIEM_WEBHOOK_URL=             # https endpoint receiving {"events":[...]} batches
ZANSKAR_SIEM_WEBHOOK_SECRET=          # >=16 chars; X-Zanskar-Signature = sha256 HMAC(secret, timestamp.body)
ZANSKAR_ALLOW_PLAIN_HTTP=false        # true only for local docker compose; never in production
